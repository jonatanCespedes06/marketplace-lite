{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@marketplace/*": ["packages/*/src"]
    },
    "jsx": "react-jsx",
    "sourceMap": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src"],
  "references": [
    { "path": "../shared" }
  ],
  "exclude": ["node_modules", "dist"]
}