    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "vitest": "^2.0.5",
    "tsx": "^4.7.0",
    "tsc-alias": "^1.8.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0"
