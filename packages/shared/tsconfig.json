{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@marketplace/*": ["packages/*/src"]
    },
    "declaration": true,
    "composite": true,
    "outDir": "dist",
    "rootDir": "src"
  }
}